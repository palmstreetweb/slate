# Optional — base URL for Slate Share panel public links + QR codes.
# No trailing slash. The form slug is appended: {base}/{slug}
# Example: https://805sealcoating.com/quote
VITE_PUBLIC_FORM_BASE=

# Optional — remote file upload endpoint for file_upload questions.
# POST multipart: file + questionId. JSON response: { "url": "..." } or { "key": "..." }
# When unset, optimized files are stored in the browser (IndexedDB) for demo/admin use.
# When Neon Object Storage is configured (VITE_STORAGE_SIGN_URL), uploads use that instead.
# VITE_UPLOAD_URL=

# Production Slate admin (ADR-029) — Neon Data API + Managed Better Auth.
# HTTPS database URL from Neon Console (Connect → host + db name over https), e.g.:
# https://ep-xxxx.us-east-2.aws.neon.tech/neondb
# See neon/SETUP.md. Place `.env.local` at repo root (vite envDir). Restart `npm run dev` after edits.
VITE_NEON_URL=

# Neon Functions (deployed separately — see neon/SETUP.md)
VITE_SUBMIT_URL=
VITE_STORAGE_SIGN_URL=

# Local UI testing without login: set to 1 while Neon URL may still be present.
# Admin uses localStorage; remove or set 0 to test Google OAuth / magic link locally.
# VITE_ADMIN_OFFLINE=1

# Server-side only — Build with AI (ADR-039). Never prefix with VITE_.
# Required for POST /api/generate (Vercel + `npm run dev` via Vite middleware).
# Production / preview: set on the Vercel project. Local: `.env.local`.
# `vercel dev` also serves /api if you prefer that over `npm run dev`.
# ANTHROPIC_API_KEY=

# Server-side only (Neon Functions — never expose in the SPA):
# RESEND_API_KEY=
# PSW_NOTIFY_EMAIL=hello@palmstreetweb.com
# PUBLIC_FORM_BASE=https://slateforms.vercel.app
# authemail (ADR-037): NEON_AUTH_URL=https://ep-….neonauth….aws.neon.tech/neondb/auth
# AUTH_EMAIL_FROM=Slate <notifications@palmstreetweb.com>
# Vercel webhook proxy: AUTH_EMAIL_FUNCTION_URL=https://….authemail….neon.tech
# ADR-031 upload guards (storagesign): STORAGE_SIGN_MAX_BYTES, STORAGE_SIGN_IP_*
# ADR-030 submit limits (submitresponse): SUBMIT_RATE_*
